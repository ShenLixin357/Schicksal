# Set this in Cloudflare Worker Settings > Variables and Secrets as a Secret.
# JSON keys: amberina (owner, required), zxy, truth, kaito, harry (invitees, optional).
# Configure each invited member with a different password, at least 12 characters.
SCHICKSAL_MEMBER_PASSWORDS=

# Free photo storage. Set both values as Cloudflare Worker Secrets.
# SUPABASE_SECRET_KEY is a server-only sb_secret_... key; never commit a real key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Create a PRIVATE Supabase Storage bucket with this exact name.
SUPABASE_STORAGE_BUCKET=schicksal-photos
