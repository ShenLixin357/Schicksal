{
  "name": "schicksal-first-empire",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "vite",
    "build": "npm run game:import && node scripts/insaniquarium/check-engine.mjs && node scripts/insaniquarium/check-resources.mjs && vinext build",
    "start": "vinext start",
    "test": "npm run test:records && npm run test:migration && npm run test:deployment && npm run test:photos && npm run test:privacy && npm run test:parliament && npm run test:minigames && npm run test:solitaire && npm run test:ice-fire && npm run test:lounge && npm run test:cello && npm run test:vase && npm run test:messenger && npm run test:shell && npm run test:architecture && npm run test:identity && npm run test:backup-restore && npm run test:migration-authority && npm run db:check && npm run test:isolation && npm run test:game-room-return && npm run test:lounge-api && npm run test:identity-architecture && npm run test:asset-audit && npm run test:profile-crystal && npm run test:performance && npm run test:mark-placements && npm run test:visual-interactions && npm run test:lounge-return && npm run test:sidebar-visual-parity && npm run test:briefing",
    "test:briefing": "node --experimental-transform-types --test tests/amberina-simple-emblem.test.mjs tests/briefing-data.test.mjs tests/briefing-preload.test.mjs tests/briefing-feed.test.mjs tests/briefing-api.test.mjs tests/briefing-inbox.test.mjs tests/briefing-art-contract.test.mjs tests/briefing-preview-config.test.mjs",
    "test:solitaire": "node --experimental-transform-types --test tests/solitaire-engine.test.ts",
    "test:minigames": "node --experimental-transform-types --test tests/potion-sort-engine.test.ts tests/merge-game-engine.test.ts tests/chryser-games.test.ts",
    "test:mafraer": "node --experimental-transform-types --test tests/mafraer-magic.test.ts tests/mafraer-observatory.test.ts",
    "test:records": "node --import ./tests/vite-css-hook.mjs --experimental-transform-types --test tests/game-records.test.ts tests/game-records-api.test.mjs",
    "test:migration": "node --import ./tests/vite-css-hook.mjs --experimental-transform-types --test tests/cloudflare-migration.test.mjs",
    "cloudflare:prepare": "node scripts/cloudflare/prepare.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "node --experimental-transform-types scripts/migrations.mjs new",
    "deploy": "node scripts/cloudflare/deploy-build.mjs",
    "db:migrate": "node --experimental-transform-types scripts/cloudflare/deploy-build.mjs --migrate-only",
    "test:deployment": "node --test tests/cloudflare-deploy.test.mjs",
    "test:parliament": "node --import ./tests/vite-css-hook.mjs --experimental-transform-types --test tests/parliament-speaker-api.test.mjs tests/parliament-document-versions.test.mjs",
    "test:photos": "node --experimental-transform-types --test tests/photo-storage.test.mjs",
    "test:privacy": "node --import ./tests/vite-css-hook.mjs --experimental-transform-types --test tests/private-site.test.mjs tests/rendered-html.test.mjs",
    "game:import": "node scripts/ice-fire/sync-upstream.mjs --import",
    "build:with-ice-fire": "npm run build",
    "test:ice-fire": "node --test tests/ice-fire-compat.test.mjs tests/ice-fire-import.test.mjs",
    "game:build-native": "bash ports/insaniquarium/build-web.sh",
    "test:insaniquarium": "node --experimental-transform-types --test tests/insaniquarium-api.test.mjs tests/insaniquarium-client.test.mjs tests/insaniquarium-runtime.test.mjs tests/insaniquarium-zip.test.mjs tests/insaniquarium-hosted-assets.test.mjs",
    "test:vase": "node --import ./tests/vite-css-hook.mjs --experimental-transform-types --test tests/vase-experience.test.mjs",
    "test:lounge": "node --import ./tests/vite-css-hook.mjs --experimental-transform-types --test tests/lounge-chat-history.test.mjs tests/no2-lounge-scythe.test.mjs",
    "test:cello": "node --experimental-strip-types --test tests/emerald-cello.test.mjs tests/cello-audio.test.mjs",
    "test:messenger": "node --experimental-transform-types --test tests/messenger-api.test.mjs",
    "test:shell": "node --test tests/shell-preview.test.mjs tests/passage-gate.test.mjs",
    "test:architecture": "node scripts/architecture/check-boundaries.mjs && node --test tests/architecture-phase1.test.mjs tests/architecture-phase2.test.mjs && npm run audit:assets",
    "audit:assets": "node scripts/architecture/audit-assets.mjs",
    "db:check": "node --experimental-transform-types scripts/migrations.mjs check",
    "db:seal": "node scripts/migrations.mjs seal",
    "db:new": "node scripts/migrations.mjs new",
    "test:identity": "node --import ./tests/vite-css-hook.mjs --experimental-transform-types --test tests/identity-boundary.test.mjs",
    "test:backup-restore": "node --experimental-transform-types --test tests/backup-restore.test.mjs",
    "test:migration-authority": "node --experimental-transform-types --test tests/migration-authority.test.mjs",
    "backup:capture": "node --experimental-transform-types scripts/cloudflare/backup.mjs capture",
    "backup:verify": "node --experimental-transform-types scripts/cloudflare/backup.mjs verify",
    "backup:restore-local": "node --experimental-transform-types scripts/cloudflare/backup.mjs restore-local",
    "deploy:check": "node --experimental-transform-types scripts/cloudflare/deploy-build.mjs --check",
    "test:isolation": "node --test tests/architecture-phase-d.test.mjs",
    "test:game-room-return": "node --experimental-transform-types --test tests/game-room-return.test.mjs",
    "test:lounge-api": "node --experimental-transform-types --test tests/lounge-api.test.mjs",
    "test:identity-architecture": "node --experimental-transform-types --test tests/identity-architecture.test.mjs tests/no2-personal-symbol.test.mjs",
    "test:asset-audit": "node --test tests/public-assets-budget.test.mjs",
    "test:profile-crystal": "node --experimental-transform-types --test tests/profile-crystal.test.mjs",
    "test:performance": "node --test tests/performance-boundaries.test.mjs",
    "test:mark-placements": "node --experimental-transform-types --test tests/mark-placements.test.mjs",
    "test:visual-interactions": "node --experimental-transform-types --test tests/visual-interaction-regressions.test.mjs",
    "test:lounge-return": "node --test tests/lounge-in-app-return.test.mjs",
    "test:sidebar-visual-parity": "node --test tests/sidebar-visual-parity.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Schicksal — 天命第一帝国"
}
